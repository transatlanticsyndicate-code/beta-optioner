# Crypto окружение (crypto.optioner.online)
# ЗАЧЕМ: Конфигурация фронтенда Vite для поддомена crypto
# Реальные значения — в crypto/.env.local (в git не попадает)

# Supabase anon publishable key
# URL формируется автоматически из window.location.origin + /sb (проксирование через наш nginx)
VITE_SUPABASE_ANON_KEY=your_anon_publishable_key_here

# Опционально — переопределить URL Supabase напрямую (в обход прокси).
# Полезно, если нужно временно работать с реальным доменом Supabase.
# VITE_SUPABASE_URL=https://your-project.supabase.co
