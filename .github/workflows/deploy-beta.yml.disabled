# ОТКЛЮЧЕНО 2026-09-22.
# Автодеплой через GitHub Actions никогда не был настроен до конца (нет секретов) и падал
# на каждом пуше, создавая ложное ощущение поломки. Реальный деплой идёт вручную:
# ./scripts/deploy_local.sh (сборка на маке + rsync на сервер).
# Расширение .disabled снято с .yml намеренно — GitHub такой файл не запускает.
# Чтобы вернуть автодеплой: настроить секреты репозитория и переименовать файл обратно.

name: Deploy to Beta Server

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
      
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
          cache: 'npm'
          cache-dependency-path: 'frontend/package-lock.json'
      
      - name: Install frontend dependencies
        run: npm ci
        working-directory: frontend
      
      - name: Build frontend
        run: npm run build
        working-directory: frontend
      
      - name: Deploy to Beta Server
        env:
          DEPLOY_HOST: ${{ secrets.BETA_DEPLOY_HOST }}
          DEPLOY_USER: ${{ secrets.BETA_DEPLOY_USER }}
          DEPLOY_PASSWORD: ${{ secrets.BETA_DEPLOY_PASSWORD }}
          DEPLOY_PATH: ${{ secrets.BETA_DEPLOY_PATH }}
        run: |
          apt-get update && apt-get install -y sshpass
          sshpass -p "$DEPLOY_PASSWORD" scp -o StrictHostKeyChecking=no -r frontend/build/* \
            "$DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_PATH/frontend/build/"
          sshpass -p "$DEPLOY_PASSWORD" ssh -o StrictHostKeyChecking=no \
            "$DEPLOY_USER@$DEPLOY_HOST" \
            "cd $DEPLOY_PATH && git pull origin main && systemctl reload nginx && pm2 restart all"
      
      - name: Notify on success
        if: success()
        run: echo "✅ Deployment to beta.optioner.online completed successfully"
      
      - name: Notify on failure
        if: failure()
        run: exit 1
