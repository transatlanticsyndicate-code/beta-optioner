{
  "manifest_version": 3,
  "name": "Options CP Buttons",
  "version": "1.6.26",
  "description": "Кнопки +C +P -C -P для доски опционов TradingView → Optioner Calculator + автообновление сохранённых сделок",

  "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"],

  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://beta.optioner.online/*",
    "http://localhost:3000/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Options CP Buttons",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/options/*"],
      "js": [
        "src/config.js",
        "src/utils.js",
        "src/parser.js",
        "src/healthCheck.js",
        "src/storage.js",
        "src/optioner.js",
        "src/panel.js",
        "src/buttonsUI.js",
        "src/buttonsHandlers.js",
        "src/northSupport.js",
        "src/mainInit.js"
      ],
      "css": ["ext2.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://beta.optioner.online/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/calcStorageGuard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://beta.optioner.online/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/config.js", "optioner.js"],
      "run_at": "document_start"
    }
  ]
}
